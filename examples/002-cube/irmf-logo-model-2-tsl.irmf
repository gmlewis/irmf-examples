const sphere = (radius, p) => {
  return select(length(p).lessThanEqual(radius), float(1.0), float(0.0));
};

const cyl = (radius, uv) => {
  return select(length(uv).lessThanEqual(radius), float(1.0), float(0.0));
};

const mainModel4 = (xyz) => {
  const r2 = 3.3;
  return [
    sphere(6.3, xyz)
      .sub(sphere(5.6, xyz))
      .sub(cyl(r2, xyz.yz))
      .sub(cyl(r2, xyz.xz))
      .sub(cyl(r2, xyz.xy)),
  ];
};
