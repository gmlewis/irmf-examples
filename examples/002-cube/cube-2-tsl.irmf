  "options": {},
  "title": "10mm diameter Cube",
  "units": "mm",
  "version": "1.0"
}*/

const cube = (size, xyz) => {
  const p = xyz.div(size); // Scale local coordinate system.
  const outside = any(p.abs().greaterThan(float(0.5)));
  return select(outside, float(0.0), float(1.0));
};

const mainModel4 = (xyz) => [cube(10.0, xyz)];
