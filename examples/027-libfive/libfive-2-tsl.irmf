const cube = (xyz) => {
  return select(any(xyz.abs().greaterThan(1.0)), float(0.0), float(1.0));
};

const mainModel4 = (xyz) => {
  const cz = cos(xyz.z);
  const sz = sin(xyz.z);
  const twist = vec3(
    cz.mul(xyz.x).add(sz.mul(xyz.y)),
    cz.mul(xyz.y).sub(sz.mul(xyz.x)),
    xyz.z
  );
  return [cube(twist)];
};
