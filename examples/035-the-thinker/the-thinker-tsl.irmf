]).toVar();

const MIN_BOUND = vec3(-38.2827, -43.7592, -84.0721);
const MAX_BOUND = vec3(77.3013, 34.5859, 71.5131);
const DIMS = 64.0;
const VOXEL_SIZE = MAX_BOUND.sub(MIN_BOUND).div(DIMS);

const mainModel4 = (xyz) => {
  const v = floor(xyz.sub(MIN_BOUND).div(VOXEL_SIZE));
  const inRange = v.x.greaterThanEqual(0.0).and(v.x.lessThan(DIMS))
    .and(v.y.greaterThanEqual(0.0)).and(v.y.lessThan(DIMS))
    .and(v.z.greaterThanEqual(0.0)).and(v.z.lessThan(DIMS));
  // Clamp so the dynamic index is always in bounds even outside the box.
  const xf = clamp(v.x, 0.0, DIMS - 1.0);
  const yf = clamp(v.y, 0.0, DIMS - 1.0);
  const zf = clamp(v.z, 0.0, DIMS - 1.0);
  const xw = floor(xf.div(32.0));
  const wordIndex = zf.mul(DIMS).add(yf).mul(2.0).add(xw);
  const bit = uint(xf.sub(xw.mul(32.0)));
  const word = WORDS.element(wordIndex);
  const bitVal = word.shiftRight(bit).bitAnd(uint(1));
  const inside = inRange.and(bitVal.equal(uint(1)));
  return [select(inside, float(1.0), float(0.0))];
};
