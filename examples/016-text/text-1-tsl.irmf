const glyph_s = (height, p) => {
  const blocked = (any((p).lessThan(vec3(63, -16, 0)))).or(any((p).greaterThan(vec3(802, 1054, height))));
  const q = p.sub(vec3(63.00,-16.00,0.0));
  return select(blocked, float(0.0), glyph_s_1(q));
